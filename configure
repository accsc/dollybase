#!/bin/bash
#
# configure — detect build environment for dollybase
#
# Usage: ./configure [OPTIONS]
#   --prefix=DIR        Install prefix (default: /usr/local)
#   --enable-debug      Build with debug symbols and verbose warnings
#   --help              Show this help
#

set -e

PREFIX="/usr/local"
ENABLE_DEBUG="no"

while [ $# -gt 0 ]; do
  case "$1" in
    --prefix=*)  PREFIX="${1#*=}"; shift ;;
    --prefix)    shift; PREFIX="$1" ;;
    --enable-debug)  ENABLE_DEBUG="yes"; shift ;;
    --help)
      echo "Usage: ./configure [OPTIONS]"
      echo ""
      echo "  --prefix=DIR        Install prefix (default: /usr/local)"
      echo "  --enable-debug      Build with debug symbols and verbose warnings"
      echo "  --help              Show this help"
      exit 0
      ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
done

# --- Detect compiler ---
CC="${CC:-gcc}"
if ! command -v "$CC" >/dev/null 2>&1; then
  echo "ERROR: Compiler '$CC' not found."
  exit 1
fi
echo "Using compiler: $CC"

# --- Detect ncurses (required) ---
NCURSES_CFLAGS=""
NCURSES_LIBS=""
HAVE_PKG_CONFIG="no"

if command -v pkg-config >/dev/null 2>&1; then
  HAVE_PKG_CONFIG="yes"
  if pkg-config --silence-errors ncurses; then
    NCURSES_CFLAGS=$(pkg-config --cflags ncurses)
    NCURSES_LIBS=$(pkg-config --libs ncurses)
    echo "Found ncurses via pkg-config"
  else
    echo "ERROR: ncurses is required but not found via pkg-config."
    exit 1
  fi
else
  echo "ERROR: pkg-config is required to detect ncurses."
  exit 1
fi

# --- Debug flags ---
CFLAGS="-w"
LDFLAGS=""
if [ "$ENABLE_DEBUG" = "yes" ]; then
  CFLAGS="-g -O0 -DDEBUG"
  echo "Debug build enabled"
fi

# --- Version ---
VERSION="0.4"
if [ -f libdbase_4/VERSION ]; then
  VERSION=$(cat libdbase_4/VERSION)
fi

# --- Write config.mk ---
cat > config.mk <<EOF
# Generated by configure — do not edit by hand
CC = ${CC}
CFLAGS = ${CFLAGS}
LDFLAGS = ${LDFLAGS}
PREFIX = ${PREFIX}
VERSION = ${VERSION}
NCURSES_CFLAGS = ${NCURSES_CFLAGS}
NCURSES_LIBS = ${NCURSES_LIBS}
HAVE_PKG_CONFIG = ${HAVE_PKG_CONFIG}
EOF

echo ""
echo "Configuration complete:"
echo "  Compiler       : $CC"
echo "  CFLAGS         : $CFLAGS"
echo "  Prefix         : $PREFIX"
echo "  Version        : $VERSION"
echo "  NCURSES_CFLAGS : $NCURSES_CFLAGS"
echo "  NCURSES_LIBS   : $NCURSES_LIBS"
echo ""
echo "Now run 'make' to build."
